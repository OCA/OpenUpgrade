<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="payment.payment_provider_payu" model="payment.provider">
    <field name="redirect_form_view_id" ref="payment.generic_redirect_form"/>
  </record>
  <record id="payment_method_emi_india" model="payment.method">
    <field name="support_manual_capture" eval="'none'"/>
    <field name="support_refund" eval="'none'"/>
    <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
    <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
    <field name="provider_id" ref="payment.payment_provider_payu"/>
  </record>
  <record id="payment_method_netbanking" model="payment.method">
    <field name="support_manual_capture" eval="'none'"/>
    <field name="support_refund" eval="'none'"/>
    <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
    <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
    <field name="provider_id" ref="payment.payment_provider_payu"/>
  </record>
  <record id="payment_method_paylater_india" model="payment.method">
    <field name="support_manual_capture" eval="'none'"/>
    <field name="support_refund" eval="'none'"/>
    <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
    <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
    <field name="provider_id" ref="payment.payment_provider_payu"/>
  </record>
  <record id="payment_method_rupay" model="payment.method">
    <field name="primary_payment_method_id" eval="ref('payment_payu.payment_method_card')"/>
    <field name="provider_id" ref="payment.payment_provider_payu"/>
  </record>
</odoo>
