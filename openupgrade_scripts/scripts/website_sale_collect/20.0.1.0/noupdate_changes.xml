<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="carrier_pick_up_in_store" model="delivery.carrier" forcecreate="0">
    <field name="website_id" ref="base.default_website"/>
  </record>
  <record id="payment_method_pay_on_site" model="payment.method">
    <field name="provider_id" ref="website_sale_collect.payment_provider_on_site"/>
  </record>
  <record id="payment_provider_on_site" model="payment.provider">
    <field name="payment_method_ids" eval="None"/>
    <field name="pending_msg" type="html">
      <p>Your order will be ready soon.</p>
    </field>
    <field name="redirect_form_view_id" ref="payment.generic_redirect_form"/>
    <field name="is_live">True</field>
    <field name="sequence">40</field>
  </record>
</odoo>
