<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="group_hr_timesheet_approver" model="res.groups">
    <field name="comment">Can manage timesheets for all employees, but can only approve timesheets and billing targets for their team members. Has access to reporting.</field>
  </record>
  <record id="group_hr_timesheet_user" model="res.groups">
    <field name="comment">Can only manage their own timesheets.</field>
  </record>
  <record id="group_timesheet_manager" model="res.groups">
    <field name="comment">Can manage and approve all timesheets, with access to reporting and configuration.</field>
  </record>
  <record id="project.account_analytic_line_rule_manager" model="ir.access">
    <field name="active">False</field>
  </record>
  <record id="timesheet_line_rule_portal_user" model="ir.access">
    <field name="domain">[
                ('project_id', '!=', False),
                ('project_id.privacy_visibility', 'in', ['invited_users', 'portal']),
                ('project_id.collaborator_ids.partner_id', 'in', [user.partner_id.id]),
            ]</field>
    <field name="group_id" ref="base.group_portal"/>
    <field name="operation">r</field>
  </record>
</odoo>
